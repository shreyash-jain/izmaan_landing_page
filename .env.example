# Copy to .env.local for local development. Never commit the filled-in file.
#
# With NONE of the GOOGLE_ANALYTICS_* variables set, /api/analytics serves
# demo data behind a "DEMO DATA" banner. Setting all three switches it to live
# data — no code change needed.

# ── Public (safe to expose — ships in the page source, by design) ────────
# OPTIONAL. The live measurement ID already lives in lib/site.ts, so the
# tracking tag works without this. Set it only to point a build at a different
# GA4 property (a staging property, say) — it overrides lib/site.ts.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Server-side only — these live in the Cloudflare Pages Function ───────
# NEVER give these a NEXT_PUBLIC_ prefix: that would compile them into the
# static bundle and publish the private key to every visitor.

# ~9-digit number. GA4 → Admin → Property details (top right).
# NOT the G-XXXXXXXXXX measurement ID and NOT the Stream ID.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789

# The service account's client_email from its JSON key.
GOOGLE_ANALYTICS_CLIENT_EMAIL=izmaan-analytics@your-project.iam.gserviceaccount.com

# The private_key from the same JSON, INCLUDING the BEGIN/END lines.
# In this file: keep the double quotes and the literal \n sequences.
# In the Cloudflare dashboard: paste it RAW, with no surrounding quotes.
GOOGLE_ANALYTICS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ── Dashboard login ─────────────────────────────────────────────────────
# When both are set, /api/analytics rejects unauthenticated requests with 401.
# When either is missing the endpoint is OPEN — fine locally, not in production.
ADMIN_USERNAME=izmaan
ADMIN_PASSWORD=choose-a-long-random-password
